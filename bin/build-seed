#!/usr/bin/env bash
# shellcheck disable=2086

set -eu -o pipefail

# {{{ getopt

seedAttr=seed
registry=ghcr.io
imageName=

usage() {
  cat <<EOF
Usage:
  build-seed [ PATH ]
Options:
  --seed-attr SEED_ATTR
    name of the seed package attr (default: $seedAttr)
  --registry REGISTRY
    target registry (default: $registry)
  --image-name IMAGE_NAME
    repository to push, e.g. org/nix-seed
    (default: <gh repo nameWithOwner>/<PATH relative to repo root>)
  --tag TAG
    add an extra tag such as IMAGE_NAME:latest
Args:
  PATH  path to flake (default=.)
EOF
}

# hand-rolled rather than getopt(1): only GNU getopt supports --long, and
# macOS ships the BSD one. this also drops a util-linux dependency.
tags=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --seed-attr)
    seedAttr=$2
    shift 2
    ;;
  --registry)
    registry=$2
    shift 2
    ;;
  --image-name)
    imageName=$2
    shift 2
    ;;
  --tag)
    tags+=("$2")
    shift 2
    ;;
  --)
    shift
    break
    ;;
  -*)
    usage
    exit 1
    ;;
  *)
    break
    ;;
  esac
done

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

dir=${1:-.}
[[ $dir =~ ^/ ]] || dir=./$dir

# the seed attribute names its image and lock: attr "seed" -> image
# .../seed + .seed.lock. dots become dashes so a nested attribute is
# still a legal image name and filename.
suffix=${seedAttr//./-}

if [[ -z $imageName ]]; then
  command -v gh >/dev/null || {
    echo >&2 "<gh> github command line client required to resolve image name"
    exit 1
  }
  repository=$(cd $dir && gh repo view --json nameWithOwner --jq .nameWithOwner)
  # path of $dir relative to the repo root ("" at the root)
  rel=$(git -C $dir rev-parse --show-prefix)
  imageName=$repository${rel:+/${rel%/}}/$suffix
fi
# ghcr requires lowercase repository names. tr, not ${x,,}: macOS runners
# resolve `shell: bash` to /bin/bash 3.2, which has no case expansion.
imageName=$(printf '%s' "$imageName" | tr '[:upper:]' '[:lower:]')
repository=$registry/$imageName

# }}}

# {{{ sanity check

[[ -n ${REGISTRY_USER:-} && -n ${REGISTRY_PASS:-} ]] || {
  echo >&2 "REGISTRY_USER and REGISTRY_PASS must be set"
  exit 1
}

# }}}

seed=$dir#$seedAttr
lock=$dir/.$suffix.lock

echo '::group::seed: eval'
eval "$(nix eval --impure --json --apply 'seed: {
  inherit (seed) name tag;
  system = builtins.currentSystem;
}' "$seed" | jq -r '
"name=\(.name | @sh)
tag=\(.tag | @sh)
system=\(.system | @sh)"
')"
# the darwin/linux split is a 1:1 function of system, so derive the
# filename here rather than reading it back out of the seed's own
# evaluation (mkseed/default.nix no longer exposes it).
artifact=store.squashfs
# the dmg is uncompressed -- attach and every read go through the
# codec otherwise, see DESIGN.md#macos -- and travels over zstd.
[[ $system =~ darwin ]] && artifact=store.dmg.zst
echo '::endgroup::'

# build the seed (registration + nix.conf are baked inside it under
# .seed/). a pure evaluation: the seed is built from the flake's own
# inputs and nothing else.
echo '::group::seed: build'
out=$(nix build --print-build-logs --no-link --print-out-paths $seed)
echo "Built seed $name:$tag ($system)"
echo '::endgroup::'

# on darwin the derivation yields the image's *inputs*, not the image:
# hdiutil needs diskarbitrationd and cannot run in the nix sandbox, so
# the packaging step happens here. see DESIGN.md#macos.
if [[ $system =~ darwin ]]; then
  echo '::group::seed: package'
  image=$(mktemp -d)/image
  "$(dirname "$0")"/make-dmg "$out" "$image/$artifact"
  out=$image
  echo '::endgroup::'
fi

# {{{ push

tags+=(
  "$tag"
  #  "$(git -C $dir describe --tags --always --dirty)"
)

# push the seed as an OCI artifact (not an image): plain blobs, no
# engine, no layer extraction on the consumer. oras itself is not
# preinstalled on any runner, so fetch it here if missing -- used only
# for this push; the consumer side (bin/mount-seed) talks to the
# registry directly over the OCI HTTP API instead, so it never needs it.
echo '::group::seed: install oras'
if ! command -v oras >/dev/null; then
  orasVersion=1.3.3
  # uname, not dpkg: the latter is Debian-only and absent on macOS. oras
  # publishes linux and darwin builds for both architectures.
  orasOs=$(uname -s | tr '[:upper:]' '[:lower:]') # linux | darwin
  case $(uname -m) in
  x86_64 | amd64) orasArch=amd64 ;;
  aarch64 | arm64) orasArch=arm64 ;;
  *)
    echo >&2 "build-seed: unsupported architecture $(uname -m)"
    exit 1
    ;;
  esac
  orasTmp=$(mktemp -d)
  trap 'rm -rf "$orasTmp"' EXIT
  curl --fail --silent --show-error --location \
    "https://github.com/oras-project/oras/releases/download/v$orasVersion/oras_${orasVersion}_${orasOs}_${orasArch}.tar.gz" |
    tar -xz -C "$orasTmp" oras
  sudo install "$orasTmp/oras" /usr/local/bin/oras
fi
echo '::endgroup::'

echo '::group::seed: push'
oras login "$registry" --username "$REGISTRY_USER" --password-stdin \
  <<<"$REGISTRY_PASS"
# capture the digest of *this* push, not `oras resolve "$repository:$tag"`:
# the per-arch builds run concurrently and share $tag (the git rev), so
# re-resolving the tag races -- whoever pushes last owns it, and both arches
# would record that one (wrong-arch) digest, poisoning the lock.
digest=$(
  cd "$out"
  oras push "$repository:$tag" \
    "$artifact:application/vnd.nix-seed.$system" \
    --format go-template="{{.digest}}"
)
# extra tags: retag the same manifest, no re-upload
for t in "${tags[@]}"; do
  [[ $t == "$tag" ]] || oras tag "$repository@$digest" "$t"
done
echo '::endgroup::'
echo "pushed $repository@$digest"

# }}}

# {{{ update seed lock

# fresh object: drops legacy keys, and rewrites only this system's entry.
# the tag lives inside that entry rather than at the top level because it
# is per-system state: it defaults to self.rev (mkseed/default.nix), which
# moves with every `chore(seed): lock` commit, so the systems of one
# logical seed are routinely pushed under different tags. a single shared
# tag therefore made every sibling look stale, and the old "tag changed ->
# reset systems" rule let whichever system committed last erase the
# others -- leaving the consumer's lock with no entry for its own system
# at all. staleness is now recorded per system and invalidates nothing but
# the entry it belongs to.
update_lock() {
  [[ -f $lock ]] || printf '{}\n' >$lock
  jq --sort-keys \
    --arg repository "$repository" --arg tag "$tag" \
    --arg system "$system" --arg digest "$digest" \
    '{
      repository: $repository,
      systems: ((.systems // {})
        | .[$system] = { digest: $digest, tag: $tag })
    }' $lock >$lock.tmp
  mv $lock.tmp $lock
}

echo '::group::seed: lock'
git=(git -C $dir)
"${git[@]}" config user.email >/dev/null || git+=(
  -c user.name='github-actions[bot]'
  -c user.email='41898282+github-actions[bot]@users.noreply.github.com'
)
# CI checkouts are detached, so the branch cannot be read from HEAD
branch=${GITHUB_REF_NAME:-$("${git[@]}" branch --show-current)}

# parallel per-system builds race on the push: rebuild the lock on top
# of the freshly pulled state each attempt. the loser retries, so the
# bound must exceed the number of systems seeded concurrently -- three
# now that darwin joined the matrix, times the examples sharing a lock.
committed=
for _ in $(seq 1 10); do
  "${git[@]}" pull --rebase origin $branch
  update_lock
  "${git[@]}" add -f ".$suffix.lock"
  if "${git[@]}" diff --cached --quiet; then
    committed=1 # nothing new to record
    break
  fi
  "${git[@]}" commit --message "chore($suffix): lock $system"
  if "${git[@]}" push origin HEAD:$branch; then
    committed=1
    break
  fi
  # lost the race: drop the commit and our lock edit, then retry
  "${git[@]}" reset HEAD^
  if [[ -n $("${git[@]}" ls-files ".$suffix.lock") ]]; then
    "${git[@]}" checkout -- ".$suffix.lock"
  else
    rm $lock
  fi
done
[[ -n $committed ]] || {
  echo >&2 "build-seed: could not push $lock"
  exit 1
}
echo "seed.lock: $repository:$tag $system = $digest"
echo '::endgroup::'

# }}}
